{
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/share/decks/:deckSlug",
      "destination": "/api/share-deck?deckSlug=:deckSlug"
    },
    {
      "source": "/:locale(uk|ru|pl|de|es|fr|it|pt|tr|cs|ja)",
      "destination": "/:locale/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/app.html"
    }
  ]
}
